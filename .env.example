# Telegram Bot Token — получить у @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Anthropic API Key — получить на https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Секрет для верификации GitHub Webhook (любая строка)
WEBHOOK_SECRET=your_random_secret_here

# Порт webhook-сервера (по умолчанию 9000)
WEBHOOK_PORT=9000
